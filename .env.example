# این فایل یک نمونه است. یک کپی از آن با نام .env بسازید و مقادیر واقعی را داخل آن قرار دهید.
# فایل .env هرگز نباید در گیت‌هاب آپلود شود (در .gitignore قرار دارد).

# --- دیتابیس MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
PRICE_DB_NAME=price_db
ORDERS_DB_NAME=orders_db

# --- توکن‌های ربات تلگرام (از BotFather دریافت می‌شود) ---
BOT1_TOKEN=your_bot1_token
BOT2_TOKEN=your_bot2_token
SECOND_BOT_USERNAME=your_second_bot_username

# --- شناسه‌های کانال و گروه تلگرام ---
CHANNEL_ID=your_channel_id
DISCUSSION_GROUP_ID=your_discussion_group_id
SAVED_MESSAGES_ID=your_saved_messages_id

# --- کلید API قیمت طلا و ارز (BrsApi.ir) ---
BRSAPI_KEY=your_brsapi_key

# --- مسیر فونت و تصویر ثابت (اختیاری - در صورت خالی بودن از پوشه assets استفاده می‌شود) ---
FONT_PATH=assets/Vazirmatn-RD-Regular.ttf
FIXED_IMAGE_PATH=assets/fixed_image.jpg
